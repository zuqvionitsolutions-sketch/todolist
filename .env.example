PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
# Set TRUST_PROXY only when running behind a trusted reverse proxy.
# TRUST_PROXY=1
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/todolist?retryWrites=true&w=majority
MONGODB_TIMEOUT_MS=10000
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
